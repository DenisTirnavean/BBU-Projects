<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.skelet.controller.LoginController"
            style="-fx-background-color: rgba(7,255,223,0.2)"
            prefHeight="400"
            prefWidth="400"
            stylesheets="@login.css">

    <top>
        <HBox spacing="375">
            <Label text="ERP Commerce SRL ~Login-page "
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"
                   BorderPane.alignment="CENTER"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="center" spacing="15">
            <HBox alignment="CENTER" spacing="10">
                <Label text="Username" style="-fx-font-size: 15px"/>
                <TextField fx:id="username" promptText="Username" prefWidth="180" prefHeight="50"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Password" style="-fx-font-size: 15px"/>
                <PasswordField fx:id="password" promptText="Password" prefWidth="180" prefHeight="50"/>
            </HBox>
            <Button text="Log-In" prefWidth="240" prefHeight="50"
                    style="-fx-background-color: #82ecb6"
                    onAction="#onLoginAction"/>
        </VBox>
    </center>
</BorderPane>
